# ============================================================
# Haywood Technologies — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any real credentials to git.
#
#   cp .env.example .env.local
# ============================================================

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.haywood-tech.com

# ── Analytics (add if using a self-hosted analytics provider) ─
# NEXT_PUBLIC_ANALYTICS_ID=

# ── Email / Contact form ─────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=info@haywood-tech.com

# ── CMS (if added in future) ─────────────────────────────────
# CMS_API_URL=
# CMS_API_KEY=
